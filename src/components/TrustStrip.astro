---
---

<section class="border-y border-[#2E87C6]/20 bg-[#081726]/90 py-8 relative overflow-hidden">
  {/* Subtle blueprint grid line */}
  <div class="absolute inset-0 dot-grid opacity-15 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-6">
      <div class="text-xs font-mono uppercase tracking-widest text-slate-400 shrink-0 text-center lg:text-left">
        <span class="text-[#4DA6E8]">INSTITUTIONAL VALIDATION</span> &amp; STATUTORY COMPLIANCE
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 sm:gap-8 w-full lg:w-auto items-center">
        {/* Logo 1: Government of Karnataka */}
        <div class="flex items-center gap-3 p-2.5 rounded-lg bg-[#0D2237]/60 border border-[#2E87C6]/20 hover:border-[#EE7B2B]/40 transition-colors">
          <div class="w-10 h-10 rounded-full bg-[#081726] border border-[#EE7B2B]/40 flex items-center justify-center shrink-0 shadow-sm">
            <svg viewBox="0 0 100 100" class="w-6 h-6" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="50" cy="50" r="45" stroke="#EE7B2B" stroke-width="3" stroke-dasharray="4 2" />
              {/* Lion Capital & Emblem Motif */}
              <path d="M50 18 L55 28 L66 30 L58 38 L60 49 L50 43 L40 49 L42 38 L34 30 L45 28 Z" fill="#EE7B2B" />
              <rect x="36" y="52" width="28" height="6" rx="2" fill="#38BDF8" />
              <path d="M40 60 L60 60 L56 78 L44 78 Z" fill="#EE7B2B" opacity="0.85" />
              <circle cx="50" cy="68" r="3" fill="#081726" />
            </svg>
          </div>
          <div>
            <div class="text-xs font-bold text-white font-['Outfit'] leading-tight">Govt. of Karnataka</div>
            <div class="text-[10px] font-mono text-[#EE7B2B]">₹350-Cr Signed MoU</div>
          </div>
        </div>

        {/* Logo 2: IIT Roorkee */}
        <div class="flex items-center gap-3 p-2.5 rounded-lg bg-[#0D2237]/60 border border-[#2E87C6]/20 hover:border-[#2E87C6]/40 transition-colors">
          <div class="w-10 h-10 rounded-full bg-[#081726] border border-[#2E87C6]/40 flex items-center justify-center shrink-0 shadow-sm">
            <svg viewBox="0 0 100 100" class="w-6 h-6" fill="none" xmlns="http://www.w3.org/2000/svg">
              {/* Academic Crest Shield */}
              <path d="M50 14 L78 26 V52 C78 68 50 86 50 86 C50 86 22 68 22 52 V26 Z" stroke="#2E87C6" stroke-width="3.5" fill="#0D2237" />
              <path d="M50 28 L50 62" stroke="#38BDF8" stroke-width="3" />
              <circle cx="50" cy="40" r="8" stroke="#EE7B2B" stroke-width="2" />
              <path d="M42 58 L58 58" stroke="#38BDF8" stroke-width="3" />
            </svg>
          </div>
          <div>
            <div class="text-xs font-bold text-white font-['Outfit'] leading-tight">IIT Roorkee</div>
            <div class="text-[10px] font-mono text-[#4DA6E8]">Patented HHM Tech</div>
          </div>
        </div>

        {/* Logo 3: ISO 9001 / 14001 */}
        <div class="flex items-center gap-3 p-2.5 rounded-lg bg-[#0D2237]/60 border border-[#2E87C6]/20 hover:border-emerald-500/40 transition-colors">
          <div class="w-10 h-10 rounded-full bg-[#081726] border border-emerald-500/40 flex items-center justify-center shrink-0 shadow-sm">
            <svg viewBox="0 0 100 100" class="w-6 h-6" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="50" cy="50" r="42" stroke="#10B981" stroke-width="3" />
              <circle cx="50" cy="50" r="34" stroke="#10B981" stroke-width="1.2" stroke-dasharray="3 3" />
              {/* Checkmark Ribbon */}
              <path d="M34 50 L46 62 L68 38" stroke="#10B981" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div>
            <div class="text-xs font-bold text-white font-['Outfit'] leading-tight">ISO 9001 &amp; 14001</div>
            <div class="text-[10px] font-mono text-emerald-400">Audited &amp; Certified</div>
          </div>
        </div>

        {/* Logo 4: ZLD Zero Liquid Discharge */}
        <div class="flex items-center gap-3 p-2.5 rounded-lg bg-[#0D2237]/60 border border-[#2E87C6]/20 hover:border-[#38BDF8]/40 transition-colors">
          <div class="w-10 h-10 rounded-full bg-[#081726] border border-[#38BDF8]/40 flex items-center justify-center shrink-0 shadow-sm">
            <svg viewBox="0 0 100 100" class="w-6 h-6" fill="none" xmlns="http://www.w3.org/2000/svg">
              {/* Droplet & Recycle arrows */}
              <path d="M50 18 C50 18 28 46 28 62 C28 74 38 84 50 84 C62 84 72 74 72 62 C72 46 50 18 50 18 Z" stroke="#38BDF8" stroke-width="3.5" fill="#0D2237" />
              <path d="M50 36 V66 M38 54 H62" stroke="#EE7B2B" stroke-width="2.5" stroke-linecap="round" />
            </svg>
          </div>
          <div>
            <div class="text-xs font-bold text-white font-['Outfit'] leading-tight">ZLD Compliant</div>
            <div class="text-[10px] font-mono text-[#38BDF8]">Zero Liquid Discharge</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
