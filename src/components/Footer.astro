---
import { Cpu, Mail, MapPin, Globe, ExternalLink, ShieldCheck } from 'lucide-react';
---

<footer class="bg-[#050E17] border-t border-[#2E87C6]/20 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-12 border-b border-slate-800">
      {/* Brand Bio */}
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-[#0F2840] border border-[#2E87C6]/30 flex items-center justify-center text-[#2E87C6]">
            <Cpu class="w-4 h-4" />
          </div>
          <span class="text-xl font-bold tracking-tight text-white font-['Outfit']">
            GIGA MINES
          </span>
        </div>
        <p class="text-xs text-slate-400 max-w-sm font-sans leading-relaxed">
          India's first giga-scale commercial complex to recycle, recover, and refine critical minerals (Li, Co, Ni) and rare earth elements (Nd, Dy, Pr). A strategic clean technology vertical of MiniMines Cleantech Solutions Pvt. Ltd.
        </p>

        {/* Social Media Links */}
        <div class="pt-2">
          <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block mb-2.5">
            Connect &amp; Socials
          </span>
          <div class="flex flex-wrap items-center gap-2.5">
            {/* LinkedIn */}
            <a
              href="https://www.linkedin.com/company/mini-mines/?"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="MiniMines on LinkedIn"
              title="MiniMines on LinkedIn"
              class="w-8 h-8 rounded-lg bg-[#081726] border border-[#2E87C6]/25 hover:border-[#EE7B2B] hover:text-[#EE7B2B] text-slate-300 flex items-center justify-center transition-all"
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
            </a>

            {/* X / Twitter */}
            <a
              href="https://x.com/MiniMinesPower"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="MiniMines on X / Twitter"
              title="MiniMines on X"
              class="w-8 h-8 rounded-lg bg-[#081726] border border-[#2E87C6]/25 hover:border-[#EE7B2B] hover:text-[#EE7B2B] text-slate-300 flex items-center justify-center transition-all"
            >
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-current" xmlns="http://www.w3.org/2000/svg">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>

            {/* YouTube */}
            <a
              href="https://www.youtube.com/@miniminescleantechsolution6182"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="MiniMines on YouTube"
              title="MiniMines on YouTube"
              class="w-8 h-8 rounded-lg bg-[#081726] border border-[#2E87C6]/25 hover:border-[#EE7B2B] hover:text-[#EE7B2B] text-slate-300 flex items-center justify-center transition-all"
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            {/* Instagram */}
            <a
              href="https://www.instagram.com/miniminescleantech/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="MiniMines on Instagram"
              title="MiniMines on Instagram"
              class="w-8 h-8 rounded-lg bg-[#081726] border border-[#2E87C6]/25 hover:border-[#EE7B2B] hover:text-[#EE7B2B] text-slate-300 flex items-center justify-center transition-all"
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>

            {/* Facebook */}
            <a
              href="https://www.facebook.com/minimines/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="MiniMines on Facebook"
              title="MiniMines on Facebook"
              class="w-8 h-8 rounded-lg bg-[#081726] border border-[#2E87C6]/25 hover:border-[#EE7B2B] hover:text-[#EE7B2B] text-slate-300 flex items-center justify-center transition-all"
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg">
                <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H7.5v-3H10V9.5C10 7.01 11.49 5.5 13.79 5.5c1.1 0 2.25.2 2.25.2v2.47h-1.27c-1.23 0-1.62.77-1.62 1.56V12h2.78l-.44 3h-2.34v6.8c4.56-.93 8-4.96 8-9.8z"/>
              </svg>
            </a>

            {/* Official Website */}
            <a
              href="https://m-mines.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Official Website"
              title="MiniMines Official Website"
              class="w-8 h-8 rounded-lg bg-[#081726] border border-[#2E87C6]/25 hover:border-[#EE7B2B] hover:text-[#EE7B2B] text-slate-300 flex items-center justify-center transition-all"
            >
              <Globe class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>

      {/* Platform Navigation */}
      <div>
        <h4 class="text-xs font-mono text-[#EE7B2B] uppercase tracking-wider mb-3 font-semibold">
          Platform Architecture
        </h4>
        <ul class="space-y-2 text-xs font-sans text-slate-300">
          <li><a href="#why" class="hover:text-white transition-colors">Why Domestic Refining</a></li>
          <li><a href="#model" class="hover:text-white transition-colors">The 3R Operating Model</a></li>
          <li><a href="#facility" class="hover:text-white transition-colors">Inside Giga Mines (6 Zones)</a></li>
          <li><a href="#technology" class="hover:text-white transition-colors">HHM Extraction Tech</a></li>
          <li><a href="#elements" class="hover:text-white transition-colors">Element Recovery Matrix</a></li>
          <li><a href="#impact" class="hover:text-white transition-colors">ESG &amp; Circularity Proof</a></li>
          <li><a href="#partner" class="hover:text-white transition-colors">Commercial Partnerships</a></li>
        </ul>
      </div>

      {/* Contact & Statutory Information */}
      <div>
        <h4 class="text-xs font-mono text-slate-400 uppercase tracking-wider mb-3">
          Executive Commercial Desk
        </h4>
        <ul class="space-y-2.5 text-xs font-sans text-slate-300">
          <li class="flex items-center gap-2">
            <Mail class="w-3.5 h-3.5 text-[#2E87C6]" />
            <a href="mailto:partnerships@m-mines.com" class="hover:text-white transition-colors">partnerships@m-mines.com</a>
          </li>
          <li class="flex items-start gap-2">
            <MapPin class="w-3.5 h-3.5 text-[#EE7B2B] shrink-0 mt-0.5" />
            <span>Refining Complex: Karnataka, India<br /><span class="text-slate-500 font-mono text-[11px]">HQ: Bengaluru, Karnataka</span></span>
          </li>
          <li class="flex items-center gap-2">
            <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" />
            <span>ZLD Zero-Effluent Certified</span>
          </li>
          <li class="pt-2">
            <a
              href="https://m-mines.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-mono text-[#4DA6E8] hover:text-[#EE7B2B] transition-colors"
            >
              <span>Visit MiniMines Cleantech Group</span>
              <ExternalLink class="w-3 h-3" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar: Copyright & Legal Compliance */}
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400">
      <div>
        © {new Date().getFullYear()} MiniMines Cleantech Solutions Pvt. Ltd. All rights reserved.
      </div>
      <div class="flex flex-wrap items-center gap-3 text-[11px] text-slate-400">
        <a href="#partner" class="hover:text-slate-300 transition-colors">DPDP ACT 2023 PRIVACY</a>
        <span>•</span>
        <span>ISO 9001:2015</span>
        <span>•</span>
        <span>ISO 14001:2015</span>
        <span>•</span>
        <span>ZLD COMPLIANT</span>
      </div>
    </div>
  </div>
</footer>
