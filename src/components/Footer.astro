---
import { Cpu, Mail, MapPin, Globe, ExternalLink, ShieldCheck } from 'lucide-react';
---

<footer class="bg-[#050E17] border-t border-[#2E87C6]/20 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-12 border-b border-slate-800">
      {/* Brand Bio */}
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-[#0F2840] border border-[#2E87C6]/30 flex items-center justify-center text-[#2E87C6]">
            <Cpu class="w-4 h-4" />
          </div>
          <span class="text-xl font-bold tracking-tight text-white font-['Outfit']">
            GIGA MINES
          </span>
        </div>
        <p class="text-xs text-slate-400 max-w-sm font-sans leading-relaxed">
          India's first giga-scale commercial complex to recycle, recover, and refine critical minerals (Li, Co, Ni) and rare earth elements (Nd, Dy, Pr). A strategic clean technology vertical of MiniMines Cleantech Solutions Pvt. Ltd.
        </p>

        {/* Social Media Links */}
        <div class="pt-2">
          <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block mb-2.5">
            Connect &amp; Socials
          </span>
          <div class="flex items-center gap-3">
            {/* LinkedIn */}
            <a
              href="https://www.linkedin.com/company/minimines/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="MiniMines on LinkedIn"
              class="w-8 h-8 rounded-lg bg-[#081726] border border-[#2E87C6]/25 hover:border-[#EE7B2B] hover:text-[#EE7B2B] text-slate-300 flex items-center justify-center transition-all"
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
            </a>

            {/* X / Twitter */}
            <a
              href="https://twitter.com/minimines"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="MiniMines on Twitter / X"
              class="w-8 h-8 rounded-lg bg-[#081726] border border-[#2E87C6]/25 hover:border-[#EE7B2B] hover:text-[#EE7B2B] text-slate-300 flex items-center justify-center transition-all"
            >
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-current" xmlns="http://www.w3.org/2000/svg">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>

            {/* YouTube */}
            <a
              href="https://youtube.com/@minimines"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="MiniMines on YouTube"
              class="w-8 h-8 rounded-lg bg-[#081726] border border-[#2E87C6]/25 hover:border-[#EE7B2B] hover:text-[#EE7B2B] text-slate-300 flex items-center justify-center transition-all"
            >
              <svg viewBox="0 0 24 24" class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            {/* Official Website */}
            <a
              href="https://m-mines.com"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Official Website"
              class="w-8 h-8 rounded-lg bg-[#081726] border border-[#2E87C6]/25 hover:border-[#EE7B2B] hover:text-[#EE7B2B] text-slate-300 flex items-center justify-center transition-all"
            >
              <Globe class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>

      {/* Platform Navigation */}
      <div>
        <h4 class="text-xs font-mono text-[#EE7B2B] uppercase tracking-wider mb-3 font-semibold">
          Platform Architecture
        </h4>
        <ul class="space-y-2 text-xs font-sans text-slate-300">
          <li><a href="#why" class="hover:text-white transition-colors">Why Domestic Refining</a></li>
          <li><a href="#model" class="hover:text-white transition-colors">The 3R Operating Model</a></li>
          <li><a href="#facility" class="hover:text-white transition-colors">Inside Giga Mines (6 Zones)</a></li>
          <li><a href="#technology" class="hover:text-white transition-colors">HHM Extraction Tech</a></li>
          <li><a href="#elements" class="hover:text-white transition-colors">Element Recovery Matrix</a></li>
          <li><a href="#impact" class="hover:text-white transition-colors">ESG &amp; Circularity Proof</a></li>
          <li><a href="#partner" class="hover:text-white transition-colors">Commercial Partnerships</a></li>
        </ul>
      </div>

      {/* Contact & Statutory Information */}
      <div>
        <h4 class="text-xs font-mono text-slate-400 uppercase tracking-wider mb-3">
          Executive Commercial Desk
        </h4>
        <ul class="space-y-2.5 text-xs font-sans text-slate-300">
          <li class="flex items-center gap-2">
            <Mail class="w-3.5 h-3.5 text-[#2E87C6]" />
            <a href="mailto:partnerships@m-mines.com" class="hover:text-white transition-colors">partnerships@m-mines.com</a>
          </li>
          <li class="flex items-start gap-2">
            <MapPin class="w-3.5 h-3.5 text-[#EE7B2B] shrink-0 mt-0.5" />
            <span>Refining Complex: Karnataka, India<br /><span class="text-slate-500 font-mono text-[11px]">HQ: Bengaluru, Karnataka</span></span>
          </li>
          <li class="flex items-center gap-2">
            <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" />
            <span>ZLD Zero-Effluent Certified</span>
          </li>
          <li class="pt-2">
            <a
              href="https://m-mines.com"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-mono text-[#4DA6E8] hover:text-[#EE7B2B] transition-colors"
            >
              <span>Visit MiniMines Cleantech Group</span>
              <ExternalLink class="w-3 h-3" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar: Copyright & Legal Compliance */}
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400">
      <div>
        © {new Date().getFullYear()} MiniMines Cleantech Solutions Pvt. Ltd. All rights reserved.
      </div>
      <div class="flex flex-wrap items-center gap-3 text-[11px] text-slate-400">
        <a href="#partner" class="hover:text-slate-300 transition-colors">DPDP ACT 2023 PRIVACY</a>
        <span>•</span>
        <span>ISO 9001:2015</span>
        <span>•</span>
        <span>ISO 14001:2015</span>
        <span>•</span>
        <span>ZLD COMPLIANT</span>
      </div>
    </div>
  </div>
</footer>
